# Banco PostgreSQL do produto web.
DATABASE_URL=postgres://previdenciar:previdenciar@127.0.0.1:5432/previdenciar

# Endereço do processo HTTP.
BIND_ADDR=0.0.0.0:8787

# Em desenvolvimento local, permite o usuário sintético dev@local.
# Em produção, remova ou defina como 0 e configure o Cognito abaixo.
AUTH_DISABLED=1

# Cognito (obrigatório quando AUTH_DISABLED=0).
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Copiloto e Minuta: chave da plataforma (não versionar).
# Sem AI_API_KEY, o endpoint responde 503 e o app mostra o recurso indisponível.
AI_PROVIDER_ID=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_DATA_ROOT=./data/conhecimento

# Diretório do build React para servir front e API na mesma origem.
WEB_DIST=../desktop/dist

# Origens permitidas no desenvolvimento (o site em produção usa a própria origem).
ALLOWED_ORIGINS=http://127.0.0.1:1427
