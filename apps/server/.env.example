# Banco PostgreSQL do produto web.
# Marcador, não credencial real: troque pelo seu banco ao copiar para .env.
DATABASE_URL=postgres://USUARIO:SENHA@127.0.0.1:5432/BANCO

# Endereço do processo HTTP.
BIND_ADDR=0.0.0.0:8787

# Ambiente de execução: development, test ou production.
# Sem APP_ENV (ou com valor desconhecido), o servidor trata como production.
APP_ENV=development

# Em desenvolvimento local, permite o usuário sintético dev@local.
# A flag só é aceita com APP_ENV=development ou APP_ENV=test; em production
# ela é ignorada com aviso no log e o header x-dev-user fica fora do CORS.
AUTH_DISABLED=1

# Atras de proxy, CDN ou balanceador (Cloudflare, ALB), defina como 1 para que o
# rate limit por IP use CF-Connecting-IP/X-Real-IP/X-Forwarded-For.
# Sem proxy, mantenha 0: o IP vem do endereço de conexão TCP.
TRUST_PROXY=0

# Cognito (obrigatório quando AUTH_DISABLED=0).
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Copiloto e Minuta: chave da plataforma (não versionar).
# Sem AI_API_KEY, o endpoint responde 503 e o app mostra o recurso indisponível.
AI_PROVIDER_ID=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=
AI_DATA_ROOT=./data/conhecimento

# Diretório do build React para servir front e API na mesma origem.
WEB_DIST=../desktop/dist

# Origens permitidas no desenvolvimento (o site em produção usa a própria origem).
ALLOWED_ORIGINS=http://127.0.0.1:1427

# Limites de uso por conta (janelas em memória, por processo):
#   login ............ 20 tentativas / 15 min / IP
#   cadastro ......... 3 novos cadastros / hora / IP e 5 / dia / e-mail
#   importação CNIS .. 12 / hora / e-mail (30 / hora / IP)
#   leitura de PDF ... 10 / hora / e-mail (10 / hora / IP)
#   cálculo .......... 60 / hora / e-mail
#   ferramentas ...... 120 / hora / e-mail
#   Copiloto ......... 30 mensagens / hora / e-mail
#   geração de PDF ... 20 / hora / e-mail
