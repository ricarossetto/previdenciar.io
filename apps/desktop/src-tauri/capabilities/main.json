{
  "identifier": "main-local",
  "description": "Only the local main window can invoke narrow application commands. No filesystem, shell or opener plugins. The updater and the process restart/exit permissions exist only for the signed update flow.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-bootstrap",
    "allow-save-workspace",
    "allow-pick-import-cnis",
    "allow-import-cnis-path",
    "allow-run-tool",
    "allow-run-finance",
    "allow-calculate-case",
    "allow-calculate-rgps",
    "allow-export-report",
    "allow-export-reports-batch",
    "allow-export-document",
    "allow-backup-export",
    "allow-preview-report",
    "allow-fetch-economic-snapshot",
    "allow-conferir-fabrica-rmi",
    "allow-local-economic-snapshot",
    "allow-prepare-case-from-cnis",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
