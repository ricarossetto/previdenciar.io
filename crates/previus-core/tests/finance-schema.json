  "$defs": {
    "money": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]{1,17}(\\.[0-9]{1,2})?$"
        },
        {
          "type": "object",
          "properties": {
            "currency": {
              "const": "BRL"
            },
            "amount": {
              "type": "string",
              "pattern": "^-?[0-9]{1,17}(\\.[0-9]{1,2})?$"
            }
          },
          "required": [
            "currency",
            "amount"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Canonical decimal money, two places maximum; checked absolute cap 90000000000000.00. Conversion uses cents of explicitly declared nominal units."
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]{1,7}(\\.[0-9]{1,8})?$",
      "description": "Exact eight-place signed decimal. Absolute value <= 1000000. No exponent, locale guessing, whitespace, plus sign or non-finite values."
    },
    "rounding": {
      "enum": [
        "half_away_from_zero",
        "toward_zero"
      ]
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Required nonblank source declaration; no control characters; 512 UTF-8 bytes maximum."
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "Valid year 0001..9999."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Valid ISO civil date, years 0001..9999."
    },
    "periods": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1200
    },
    "interest_mode": {
      "enum": [
        "simple",
        "compound"
      ]
    },
    "payment_timing": {
      "enum": [
        "end",
        "beginning"
      ]
    },
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "const": "future_value"
            },
            "principal_money": {
              "$ref": "#/$defs/money"
            },
            "rate_percent_per_period": {
              "$ref": "#/$defs/decimal"
            },
            "periods": {
              "$ref": "#/$defs/periods"
            }
          },
          "required": [
            "operation",
            "principal_money",
            "rate_percent_per_period",
            "periods"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
